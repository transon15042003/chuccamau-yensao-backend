{
  "name": "chuccamau-yensao-backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "smoke": "node scripts/smoke-store.mjs",
    "checkout:cod": "node scripts/checkout-cod.mjs",
    "checkout:online": "node scripts/checkout-online.mjs",
    "fix:inventory": "medusa exec ./src/scripts/fix-inventory.ts",
    "sync:inventory": "medusa exec ./src/scripts/sync-inventory-from-seed.ts",
    "sync:catalog": "medusa exec ./src/scripts/sync-catalog-from-seed.ts",
    "sync:images": "medusa exec ./src/scripts/sync-images.ts",
    "verify:oos": "node scripts/verify-oos-with-db.mjs",
    "verify:stock": "node scripts/verify-stock-sync.mjs",
    "admin:orders": "node scripts/admin-list-orders.mjs",
    "admin:cancel": "node scripts/admin-cancel-order.mjs"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.8.4",
    "@medusajs/cli": "2.8.4",
    "@medusajs/framework": "2.8.4",
    "@medusajs/medusa": "2.8.4",
    "@mikro-orm/core": "6.4.3",
    "@mikro-orm/knex": "6.4.3",
    "@mikro-orm/migrations": "6.4.3",
    "@mikro-orm/postgresql": "6.4.3",
    "awilix": "8.0.1",
    "pg": "^8.23.0",
    "posthog-node": "4.17.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.8.4",
    "@swc/core": "1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/pg": "^8",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
